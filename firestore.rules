rules_version = '2';
// À coller dans la console Firebase : Firestore Database → Règles → Publier.
// Une campagne n'est lisible qu'en connaissant son code ; la liste des campagnes n'est pas consultable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /campaigns/{campaign}/{coll}/{id} {
      allow read, write: if request.auth != null
        && campaign.matches('^[a-z0-9-]{8,40}$')
        && coll in ['bands', 'games'];
    }
  }
}
